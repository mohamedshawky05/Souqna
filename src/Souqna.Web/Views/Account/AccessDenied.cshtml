@{
    ViewData["Title"] = "غير مصرح بالدخول - سوقنا";
}
<div class="container py-5 text-center">
    <div class="card card-souqna p-5 max-w-md mx-auto shadow" style="max-width: 520px;">
        <div class="text-danger mb-3">
            <i class="bi bi-shield-x fs-1"></i>
        </div>
        <h4 class="fw-bold mb-2">عفواً، ليس لديك صلاحية للوصول إلى هذه الصفحة</h4>
        <p class="text-muted small mb-4">هذه الصفحة مخصصة فقط لأدوار محددة (مثل إدارة المنصة أو البائعين المعتمدين).</p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-accent rounded-pill px-4">العودة للرئيسية</a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary rounded-pill px-4">تسجيل الدخول بحساب آخر</a>
        </div>
    </div>
</div>
