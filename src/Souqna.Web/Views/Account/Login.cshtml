@model Souqna.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول - سوقنا";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card card-souqna p-4 p-md-5 shadow-lg">
                <div class="text-center mb-4">
                    <span class="navbar-brand-badge fs-4 mb-2">
                        <i class="bi bi-shop"></i>
                        <span>سوقنا</span>
                    </span>
                    <h4 class="fw-bold mt-2">تسجيل الدخول</h4>
                    <p class="text-muted small">أهلاً بك مجدداً في منصة سوقنا</p>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-bold">البريد الإلكتروني</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-bold">كلمة المرور</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="remCheck">
                            <label class="form-check-label small" for="remCheck">تذكرني</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-accent btn-lg w-100 rounded-pill fw-bold mb-3 shadow">
                        دخول <i class="bi bi-box-arrow-in-left ms-1"></i>
                    </button>

                    <div class="text-center small text-muted">
                        ليس لديك حساب بعد؟ <a asp-action="Register" class="text-accent fw-bold text-decoration-none">إنشاء حساب جديد</a>
                    </div>
                </form>
            </div>

            <!-- Demo Logins helper card -->
            <div class="card border-0 bg-light p-3 mt-3 text-center small text-muted">
                <div class="fw-bold mb-1">حسابات تجريبية سريعة:</div>
                <div>مدير المنصة: <code>admin@souqna.eg</code> / <code>Admin@Souqna2026!</code></div>
                <div>تاجر معتمد: <code>seller@souqna.eg</code> / <code>Seller@Souqna2026!</code></div>
                <div>مشتري تجريبي: <code>customer@souqna.eg</code> / <code>Customer@Souqna2026!</code></div>
            </div>
        </div>
    </div>
</div>
