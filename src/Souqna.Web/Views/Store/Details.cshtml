@model Souqna.Web.ViewModels.StoreProfileViewModel
@{
    ViewData["Title"] = $"{Model.Store.StoreName} - متجر معتمد في سوقنا";
}

<!-- Store Header Banner -->
<div class="position-relative bg-dark mb-4">
    <div style="height: 240px; overflow: hidden; background-color: #334155;">
        <img src="@(Model.Store.CoverUrl ?? "https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?w=1600")" class="w-100 h-100" style="object-fit: cover; opacity: 0.85;" alt="@Model.Store.StoreName">
    </div>
    <div class="container position-relative">
        <div class="card card-souqna p-4 border shadow-lg" style="margin-top: -60px;">
            <div class="d-flex flex-column flex-md-row align-items-center align-items-md-start gap-4">
                <img src="@(Model.Store.LogoUrl ?? "https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=200")" class="rounded-circle border border-4 border-white shadow" style="width: 110px; height: 110px; object-fit: cover;" alt="@Model.Store.StoreName">
                <div class="flex-grow-1 text-center text-md-start">
                    <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2 mb-2">
                        <h3 class="fw-bold mb-0">@Model.Store.StoreName</h3>
                        @if (Model.Store.IsVerified)
                        {
                            <span class="badge-verified"><i class="bi bi-patch-check-fill"></i> متجر موثق رسمياً</span>
                        }
                    </div>
                    <p class="text-muted small mb-2">@Model.Store.Description</p>
                    <div class="d-flex flex-wrap justify-content-center justify-content-md-start gap-3 small text-muted">
                        <span><i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Store.City - @Model.Store.Address</span>
                        @if (!string.IsNullOrEmpty(Model.Store.ContactPhone))
                        {
                            <span><i class="bi bi-telephone-fill text-success me-1"></i> @Model.Store.ContactPhone</span>
                        }
                        <span><i class="bi bi-box-seam me-1"></i> @Model.TotalProducts منتج</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- Store Tabs: Products & Reels -->
    <ul class="nav nav-pills justify-content-center mb-4 gap-2" id="storeTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 fw-bold" id="products-tab" data-bs-toggle="pill" data-bs-target="#store-products" type="button" role="tab" aria-controls="store-products" aria-selected="true">
                <i class="bi bi-grid me-1"></i> المنتجات (@Model.Products.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-bold" id="reels-tab" data-bs-toggle="pill" data-bs-target="#store-reels" type="button" role="tab" aria-controls="store-reels" aria-selected="false">
                <i class="bi bi-play-circle-fill text-danger me-1"></i> ريلز المتجر (@Model.Reels.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="storeTabsContent">
        <!-- Products Grid Tab -->
        <div class="tab-pane fade show active" id="store-products" role="tabpanel" aria-labelledby="products-tab">
            @if (!Model.Products.Any())
            {
                <div class="text-center py-5 bg-white border rounded-3">
                    <i class="bi bi-box-seam fs-1 text-muted"></i>
                    <h5 class="fw-bold mt-2">لا توجد منتجات منشورة حالياً في هذا المتجر</h5>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                    @foreach (var prod in Model.Products)
                    {
                        var img = prod.Images.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600";
                        <div class="col">
                            <div class="card card-souqna product-card">
                                @if (prod.SalePrice.HasValue && prod.SalePrice.Value < prod.Price)
                                {
                                    <span class="product-sale-tag">خصم</span>
                                }
                                <div class="product-img-wrapper">
                                    <img src="@img" alt="@prod.Name" loading="lazy">
                                </div>
                                <div class="card-body p-3 d-flex flex-column">
                                    <h6 class="card-title fw-bold mb-2">
                                        <a asp-controller="Product" asp-action="Details" asp-route-slug="@prod.Slug" class="text-decoration-none text-reset text-truncate d-block">
                                            @prod.Name
                                        </a>
                                    </h6>
                                    <div class="mt-auto d-flex align-items-center justify-content-between">
                                        <div class="product-price">
                                            @if (prod.SalePrice.HasValue)
                                            {
                                                <span>@prod.SalePrice.Value.ToString("N0") <small class="fs-6">ج.م</small></span>
                                            }
                                            else
                                            {
                                                <span>@prod.Price.ToString("N0") <small class="fs-6">ج.م</small></span>
                                            }
                                        </div>
                                        <button class="btn btn-accent btn-sm rounded-pill px-3" onclick="addToCart(@prod.Id, 1)">
                                            <i class="bi bi-cart-plus"></i> أضف
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Reels Tab -->
        <div class="tab-pane fade" id="store-reels" role="tabpanel" aria-labelledby="reels-tab">
            @if (!Model.Reels.Any())
            {
                <div class="text-center py-5 bg-white border rounded-3">
                    <i class="bi bi-camera-reels fs-1 text-muted"></i>
                    <h5 class="fw-bold mt-2">لم يقم هذا المتجر بنشر أي ريلز بعد</h5>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
                    @foreach (var reel in Model.Reels)
                    {
                        <div class="col">
                            <div class="card bg-black border-secondary border-opacity-25 rounded-3 overflow-hidden position-relative h-100 shadow">
                                <img src="@(reel.ThumbnailUrl ?? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400")" class="card-img-top" style="height: 300px; object-fit: cover;" alt="@reel.Title">
                                <a asp-controller="Reels" asp-action="Index" asp-route-id="@reel.Id" class="stretched-link d-flex align-items-center justify-content-center position-absolute top-50 start-50 translate-middle btn btn-danger rounded-circle p-3 shadow" style="width: 50px; height: 50px;">
                                    <i class="bi bi-play-fill fs-4 text-white"></i>
                                </a>
                                <div class="card-body p-2 bg-gradient">
                                    <h6 class="card-title text-white small fw-bold text-truncate mb-1">@reel.Title</h6>
                                    <div class="d-flex justify-content-between text-muted" style="font-size: 0.75rem;">
                                        <span><i class="bi bi-eye me-1"></i>@reel.ViewsCount مشاهدة</span>
                                        <span class="text-danger"><i class="bi bi-heart-fill me-1"></i>@reel.LikesCount</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
