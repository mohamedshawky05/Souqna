@model Souqna.Core.Entities.Order
@{
    ViewData["Title"] = $"تفاصيل الطلب {Model.OrderNumber} - سوقنا";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">تفاصيل الطلب: @Model.OrderNumber</h3>
            <span class="text-muted small"><i class="bi bi-clock me-1"></i> تاريخ الطلب: @Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</span>
        </div>
        <div>
            <span class="badge fs-6 @(Model.Status == Souqna.Core.Enums.OrderStatus.Delivered ? "bg-success" : Model.Status == Souqna.Core.Enums.OrderStatus.Canceled ? "bg-danger" : "bg-warning text-dark")">
                حالة الطلب: @Model.Status
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Suborders Details -->
        <div class="col-lg-8">
            <h5 class="fw-bold mb-3">شحنات المتاجر (@Model.StoreOrders.Count شحنات)</h5>
            @foreach (var so in Model.StoreOrders)
            {
                <div class="card card-souqna p-4 mb-3">
                    <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                        <div class="fw-bold fs-6">
                            <i class="bi bi-shop text-accent me-1"></i> @(so.Store?.StoreName ?? "متجر")
                        </div>
                        <span class="badge bg-primary">حالة الشحنة: @so.Status</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr class="small text-muted">
                                    <th>المنتج</th>
                                    <th>سعر الوحدة</th>
                                    <th>الكمية</th>
                                    <th>الإجمالي</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in so.Items)
                                {
                                    <tr>
                                        <td class="fw-bold">@item.ProductName</td>
                                        <td>@item.UnitPrice.ToString("N0") ج.م</td>
                                        <td>@item.Quantity</td>
                                        <td class="text-accent fw-bold">@item.TotalPrice.ToString("N0") ج.م</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between small text-muted pt-2 border-top">
                        <span>تكلفة شحن المتجر: @so.DeliveryFee.ToString("N0") ج.م</span>
                        <span class="fw-bold text-dark">إجمالي هذه الشحنة: @so.TotalAmount.ToString("N0") ج.م</span>
                    </div>

                    @if (!string.IsNullOrEmpty(so.TrackingNumber))
                    {
                        <div class="alert alert-info small py-1 px-2 mt-2 mb-0">
                            <i class="bi bi-truck me-1"></i> رقم تتبع الشحنة: <strong>@so.TrackingNumber</strong>
                        </div>
                    }
                </div>
            }

            @if (Model.Status == Souqna.Core.Enums.OrderStatus.Pending)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('هل أنت متأكد من رغبتك في إلغاء هذا الطلب؟');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                        <i class="bi bi-x-circle me-1"></i> إلغاء الطلب
                    </button>
                </form>
            }
        </div>

        <!-- Order Summary & Address -->
        <div class="col-lg-4">
            <div class="card card-souqna p-4 mb-3">
                <h6 class="fw-bold mb-3"><i class="bi bi-receipt me-2 text-primary"></i> ملخص الدفع</h6>
                <div class="d-flex justify-content-between small mb-2">
                    <span class="text-muted">المجموع الفرعي:</span>
                    <span class="fw-bold">@Model.Subtotal.ToString("N0") ج.م</span>
                </div>
                <div class="d-flex justify-content-between small mb-2">
                    <span class="text-muted">إجمالي الشحن:</span>
                    <span class="fw-bold text-success">@Model.DeliveryFee.ToString("N0") ج.م</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between align-items-baseline mb-3">
                    <span class="fw-bold">الإجمالي الكلي:</span>
                    <strong class="fs-4 text-accent">@Model.TotalAmount.ToString("N0") ج.م</strong>
                </div>
                <div class="small text-muted">
                    <i class="bi bi-wallet2 me-1"></i> طريقة السداد: <strong>@Model.PaymentMethod</strong>
                </div>
            </div>

            <div class="card card-souqna p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-geo-alt me-2 text-danger"></i> عنوان التوصيل</h6>
                <div class="small text-muted lh-base">
                    @Model.DeliveryAddressJson
                </div>
            </div>
        </div>
    </div>
</div>
