@if (User.Identity?.IsAuthenticated == true)
{
    <div class="dropdown notification-widget" data-notifications-url="/notifications">
        <button class="btn btn-sm btn-outline-light rounded-circle position-relative"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                aria-label="الإشعارات">
            <i class="bi bi-bell-fill"></i>
            <span class="notification-badge position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                  style="display:none"></span>
        </button>
        <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0 mt-2"
             style="width:min(360px, calc(100vw - 2rem));">
            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                <strong>الإشعارات</strong>
                <button class="btn btn-link btn-sm p-0 notification-mark-all" type="button">
                    تحديد الكل كمقروء
                </button>
            </div>
            <div class="notification-list overflow-auto" style="max-height:360px"
                 aria-live="polite">
                <div class="text-muted small text-center p-3">جارٍ تحميل الإشعارات...</div>
            </div>
        </div>
    </div>
}
