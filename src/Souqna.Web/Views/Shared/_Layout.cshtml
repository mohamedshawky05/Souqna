@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Souqna.Infrastructure.Data.SouqnaDbContext DbContext

@{
    var user = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    int cartCount = 0;
    if (user != null)
    {
        cartCount = DbContext.Carts.Where(c => c.UserId == user.Id).SelectMany(c => c.Items).Sum(i => i.Quantity);
    }
}
<!DOCTYPE html>
<html lang="ar" dir="rtl" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سوقنا | المنصة المصرية الأولى للتجارة متعددة التجار والريلز</title>
    
    <!-- Google Fonts: Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 RTL & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom Theme Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @Html.AntiForgeryToken()

    <!-- Top Announcement Bar -->
    <div class="bg-dark text-white py-1 text-center small border-bottom border-secondary border-opacity-25">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-danger ms-2">جديد</span>
                <span>اكتشف المنتجات بطريقة حية مع <strong>ريلز سوقنا</strong> بالفيديو القصير!</span>
            </div>
            <div class="d-none d-md-flex align-items-center gap-3 text-muted">
                <span><i class="bi bi-geo-alt-fill text-danger me-1"></i> متاح في جميع محافظات مصر</span>
                <span>|</span>
                <span><i class="bi bi-shield-check text-success me-1"></i> تجار معتمدون وتوثيق هوية رسمي</span>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-souqna sticky-top">
        <div class="container">
            <!-- Brand -->
            <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="navbar-brand-badge">
                    <i class="bi bi-shop"></i>
                    <span>سوقنا</span>
                </span>
                <span class="fs-6 text-white-50 d-none d-sm-inline">Souqna</span>
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Nav Content -->
            <div class="collapse navbar-collapse" id="navbarMain">
                <!-- Search Box -->
                <form class="d-flex mx-auto my-2 my-lg-0 w-100 max-w-lg" asp-controller="Marketplace" asp-action="Index" method="get" style="max-width: 480px;">
                    <div class="input-group">
                        <input type="text" name="q" class="form-control search-input-header" placeholder="ابحث عن منتج، متجر، أو علامة تجارية..." value="@Context.Request.Query["q"]">
                        <button class="btn btn-accent" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <!-- Navigation Links -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="" asp-controller="Marketplace" asp-action="Index">
                            <i class="bi bi-grid me-1"></i> السوق
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="" asp-controller="Store" asp-action="Index">
                            <i class="bi bi-houses me-1"></i> المتاجر
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white position-relative" asp-area="" asp-controller="Reels" asp-action="Index">
                            <i class="bi bi-play-circle-fill text-danger me-1"></i> ريلز
                            <span class="badge rounded-pill bg-danger" style="font-size: 0.65rem;">فيديو</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50" asp-area="" asp-controller="Subscription" asp-action="Index">
                            <i class="bi bi-gem me-1"></i> الباقات
                        </a>
                    </li>
                </ul>

                <!-- User Controls & Cart -->
                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    @await Html.PartialAsync("_NotificationBell")

                    <!-- Theme Toggle -->
                    <button class="btn btn-sm btn-outline-light rounded-circle" type="button" onclick="toggleTheme()" title="تبديل المظهر">
                        <i id="theme-toggle-icon" class="bi bi-moon-stars-fill"></i>
                    </button>

                    <!-- Cart Button -->
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-light position-relative rounded-pill px-3 py-1">
                        <i class="bi bi-cart3"></i>
                        <span class="d-none d-md-inline me-1">السلة</span>
                        <span id="cart-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="@(cartCount > 0 ? "" : "display:none;")">
                            @cartCount
                        </span>
                    </a>

                    <!-- Account / Auth -->
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown">
                            <button class="btn btn-accent rounded-pill px-3 py-1 dropdown-toggle d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                <span>@(user?.FullName ?? User.Identity?.Name)</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                @if (User.IsInRole(nameof(UserRole.Admin)))
                                {
                                    <li><h6 class="dropdown-header text-primary fw-bold"><i class="bi bi-shield-shaded me-1"></i> لوحة الإدارة</h6></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i> لوحة تحكم المنصة</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Verification" asp-action="Index"><i class="bi bi-person-check me-2"></i> طلبات التوثيق</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Plans" asp-action="Index"><i class="bi bi-credit-card me-2"></i> إدارة الباقات</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                
                                @if (User.IsInRole(nameof(UserRole.Seller)) || User.IsInRole(nameof(UserRole.Admin)))
                                {
                                    <li><h6 class="dropdown-header text-success fw-bold"><i class="bi bi-shop me-1"></i> حساب التاجر</h6></li>
                                    <li><a class="dropdown-item" asp-area="Seller" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-graph-up me-2"></i> لوحة تحكم المتجر</a></li>
                                    <li><a class="dropdown-item" asp-area="Seller" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam me-2"></i> إدارة المنتجات</a></li>
                                    <li><a class="dropdown-item" asp-area="Seller" asp-controller="Reels" asp-action="Index"><i class="bi bi-camera-reels me-2"></i> فيديوهات الريلز</a></li>
                                    <li><a class="dropdown-item" asp-area="Seller" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt me-2"></i> الطلبات الواردة</a></li>
                                    <li><a class="dropdown-item" asp-area="Seller" asp-controller="Verification" asp-action="Index"><i class="bi bi-patch-check me-2"></i> توثيق الهوية</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                }

                                <li><a class="dropdown-item" asp-area="" asp-controller="Order" asp-action="MyOrders"><i class="bi bi-bag-check me-2"></i> طلباتي</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile"><i class="bi bi-gear me-2"></i> إعدادات الحساب</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i> تسجيل الخروج</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light rounded-pill px-3 py-1">
                            <i class="bi bi-box-arrow-in-left"></i> دخول
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-accent rounded-pill px-3 py-1">
                            <i class="bi bi-person-plus"></i> انضم كبائع
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Content Body -->
    <main role="main" class="pb-4">
        <!-- TempData Toast Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="navbar-brand-badge fs-5">
                            <i class="bi bi-shop"></i>
                            <span>سوقنا</span>
                        </span>
                        <span class="text-white fw-bold">Souqna Marketplace</span>
                    </div>
                    <p class="small text-muted mb-3">
                        سوقنا هي المنصة المصرية المتكاملة للتجارة الإلكترونية متعددة التجار. نربط أصحاب المتاجر والمصنعين والحرفيين بالمشترين مباشرة مع تجربة تسوق مبتكرة تعتمد على الفيديوهات القصيرة (الريلز) وتوثيق الهوية المعتمد.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-secondary"><i class="bi bi-currency-pound me-1"></i> الجنيه المصري (EGP)</span>
                        <span class="badge bg-secondary"><i class="bi bi-shield-lock me-1"></i> معاملات آمنة 100%</span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white fw-bold mb-3">روابط سريعة</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li><a asp-controller="Marketplace" asp-action="Index">تصفح المنتجات</a></li>
                        <li><a asp-controller="Store" asp-action="Index">دليل المتاجر</a></li>
                        <li><a asp-controller="Reels" asp-action="Index">ريلز سوقنا</a></li>
                        <li><a asp-controller="Subscription" asp-action="Index">باقات التجار والأسعار</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">للتجار وأصحاب المشاريع</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Account" asp-action="Register">افتح متجرك الآن مجاناً</a></li>
                        <li><a asp-controller="Subscription" asp-action="Index">مقارنة الباقات والامتيازات</a></li>
                        <li><a asp-controller="Account" asp-action="Login">دخول لوحة تحكم التاجر</a></li>
                        <li><a href="#trust">معايير توثيق الهوية والبطاقة القومية</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">الدعم والمساعدة</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-3">
                        <li><a asp-controller="Home" asp-action="About">من نحن</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">اتصل بنا</a></li>
                        <li><a asp-controller="Home" asp-action="Terms">الشروط والأحكام</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">سياسة الخصوصية وحماية البيانات</a></li>
                    </ul>
                    <div class="small text-muted">
                        <i class="bi bi-envelope-fill me-1"></i> support@souqna.eg
                    </div>
                </div>
            </div>

            <hr class="border-secondary border-opacity-25 my-4" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-muted gap-2">
                <div>
                    &copy; @DateTime.UtcNow.Year سوقنا (Souqna) — جميع الحقوق محفوظة. صُمم وصُنع في جمهورية مصر العربية 🇪🇬
                </div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy" class="text-muted">الخصوصية</a>
                    <span>•</span>
                    <a asp-controller="Home" asp-action="Terms" class="text-muted">الشروط</a>
                    <span>•</span>
                    <span>الدفع عند الاستلام كاش (COD)</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle & Site Script -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.13/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
