@model Souqna.Web.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "الرئيسية - سوقنا أول منصة مصرية للتجارة والريلز";
}

<!-- Hero Section -->
<section class="py-5 text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);">
    <div class="position-absolute top-0 start-0 w-100 h-100 opacity-25" style="background-image: radial-gradient(#0EA5E9 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="container position-relative py-lg-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-light bg-opacity-10 text-info small mb-3 border border-info border-opacity-25">
                    <i class="bi bi-stars"></i>
                    <span>المنصة الرائدة للتجارة المعتمدة في مصر</span>
                </div>
                <h1 class="display-4 fw-bolder mb-3 lh-sm">
                    تسوق من أفضل المتاجر المصرية، <br />
                    واكتشف المنتجات عبر <span class="text-info">ريلز سوقنا</span>!
                </h1>
                <p class="lead text-light text-opacity-75 mb-4">
                    اكتشف آلاف المنتجات التراثية، العصرية والإلكترونية من تجار موثقين ومعتمدين بالبطاقة القومية، مع خيارات الدفع عند الاستلام والتوصيل السريع لجميع المحافظات.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Marketplace" asp-action="Index" class="btn btn-accent btn-lg px-4 rounded-pill">
                        <i class="bi bi-bag-fill me-2"></i> تصفح السوق
                    </a>
                    <a asp-controller="Reels" asp-action="Index" class="btn btn-outline-light btn-lg px-4 rounded-pill">
                        <i class="bi bi-play-circle-fill text-danger me-2"></i> ريلز المنتجات
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-info btn-lg px-4 rounded-pill">
                        <i class="bi bi-shop me-2"></i> افتح متجرك مجاناً
                    </a>
                </div>
            </div>
            <div class="col-lg-5 text-center">
                <div class="position-relative d-inline-block">
                    <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=600" alt="سوقنا" class="img-fluid rounded-4 shadow-lg border border-white border-opacity-20" style="max-height: 380px; object-fit: cover;">
                    <div class="position-absolute bottom-0 start-50 translate-middle-x mb-n3 bg-white text-dark p-3 rounded-3 shadow-lg d-flex align-items-center gap-3 border" style="min-width: 260px;">
                        <div class="bg-success text-white p-2 rounded-circle">
                            <i class="bi bi-patch-check-fill fs-4"></i>
                        </div>
                        <div class="text-start">
                            <div class="fw-bold small">توثيق هوية رسمي</div>
                            <div class="text-muted" style="font-size: 0.75rem;">فحص يدوي للبطاقات القومية</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Trust Highlights -->
<section class="py-4 bg-white border-bottom shadow-sm">
    <div class="container">
        <div class="row g-3 text-center text-md-start">
            <div class="col-md-3 col-6">
                <div class="d-flex align-items-center gap-3">
                    <div class="fs-1 text-primary"><i class="bi bi-shield-check"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">تجار معتمدون</h6>
                        <small class="text-muted">توثيق رسمي للهوية والمتاجر</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="d-flex align-items-center gap-3">
                    <div class="fs-1 text-success"><i class="bi bi-cash-coin"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">الدفع عند الاستلام</h6>
                        <small class="text-muted">معاينة الطلب قبل السداد</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="d-flex align-items-center gap-3">
                    <div class="fs-1 text-info"><i class="bi bi-truck"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">شحن لكل المحافظات</h6>
                        <small class="text-muted">من الإسكندرية إلى أسوان</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="d-flex align-items-center gap-3">
                    <div class="fs-1 text-danger"><i class="bi bi-camera-reels"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">ريلز وفيديوهات حية</h6>
                        <small class="text-muted">شاهد المنتج واقعياً قبل الشراء</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1">تصفح حسب الأقسام</h3>
                <p class="text-muted small mb-0">اختر من بين مجموعتنا الواسعة من التصنيفات</p>
            </div>
            <a asp-controller="Marketplace" asp-action="Index" class="btn btn-outline-accent btn-sm rounded-pill px-3">
                عرض الكل <i class="bi bi-arrow-left"></i>
            </a>
        </div>

        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3">
            @foreach (var cat in Model.Categories)
            {
                <div class="col">
                    <a asp-controller="Marketplace" asp-action="Index" asp-route-categoryId="@cat.Id" class="category-pill text-center">
                        <i class="bi @(cat.Icon ?? "bi-tag") category-icon"></i>
                        <span class="fw-bold small">@cat.NameAr</span>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Souqna Reels Spotlight Section -->
@if (Model.LatestReels.Any())
{
    <section class="py-5 bg-dark text-white position-relative">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <span class="badge bg-danger mb-2"><i class="bi bi-play-circle-fill me-1"></i> ريلز سوقنا</span>
                    <h3 class="fw-bold mb-1">فيديوهات المنتجات الحية</h3>
                    <p class="text-light text-opacity-75 small mb-0">شاهد تجربة واستعراض المنتجات بالفيديو واطلب بنقرة زر</p>
                </div>
                <a asp-controller="Reels" asp-action="Index" class="btn btn-danger rounded-pill px-4">
                    فتح ريلز سوقنا <i class="bi bi-arrow-left"></i>
                </a>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-6 g-3">
                @foreach (var reel in Model.LatestReels)
                {
                    <div class="col">
                        <div class="card bg-black border-secondary border-opacity-25 rounded-3 overflow-hidden position-relative h-100 shadow">
                            <img src="@(reel.ThumbnailUrl ?? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400")" class="card-img-top" style="height: 240px; object-fit: cover;" alt="@reel.Title">
                            <div class="position-absolute top-0 end-0 p-2">
                                @if (reel.IsSponsored)
                                {
                                    <span class="badge bg-warning text-dark small">إعلان</span>
                                }
                                <span class="badge bg-dark bg-opacity-75 small"><i class="bi bi-clock me-1"></i>@reel.DurationSeconds ثانية</span>
                            </div>
                            <a asp-controller="Reels" asp-action="Index" asp-route-id="@reel.Id" class="stretched-link d-flex align-items-center justify-content-center position-absolute top-50 start-50 translate-middle btn btn-danger rounded-circle p-3 shadow" style="width: 50px; height: 50px;">
                                <i class="bi bi-play-fill fs-4 text-white"></i>
                            </a>
                            <div class="card-body p-2 bg-gradient">
                                <h6 class="card-title text-white small fw-bold text-truncate mb-1">@reel.Title</h6>
                                <div class="d-flex justify-content-between align-items-center" style="font-size: 0.75rem;">
                                    <span class="text-muted"><i class="bi bi-eye me-1"></i>@reel.ViewsCount</span>
                                    <span class="text-danger"><i class="bi bi-heart-fill me-1"></i>@reel.LikesCount</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Featured Products Section -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1">منتجات مختارة ومميزة</h3>
                <p class="text-muted small mb-0">أعلى المنتجات تقييماً وطلباً هذا الأسبوع</p>
            </div>
            <a asp-controller="Marketplace" asp-action="Index" class="btn btn-outline-accent btn-sm rounded-pill px-3">
                عرض المزيد <i class="bi bi-arrow-left"></i>
            </a>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var prod in Model.FeaturedProducts)
            {
                var mainImg = prod.Images.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600";
                <div class="col">
                    <div class="card card-souqna product-card">
                        @if (prod.SalePrice.HasValue && prod.SalePrice.Value < prod.Price)
                        {
                            <span class="product-sale-tag">خصم</span>
                        }
                        <div class="product-img-wrapper">
                            <img src="@mainImg" alt="@prod.Name" loading="lazy">
                        </div>
                        <div class="card-body p-3 d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between small text-muted mb-1">
                                <span><i class="bi bi-shop me-1"></i>@(prod.Store?.StoreName ?? "متجر")</span>
                                @if (prod.Store?.IsVerified == true)
                                {
                                    <span class="badge-verified"><i class="bi bi-patch-check-fill"></i> موثق</span>
                                }
                            </div>
                            <h6 class="card-title fw-bold mb-2">
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="@prod.Slug" class="text-decoration-none text-reset text-truncate d-block">
                                    @prod.Name
                                </a>
                            </h6>
                            <div class="mt-auto d-flex align-items-center justify-content-between">
                                <div>
                                    @if (prod.SalePrice.HasValue)
                                    {
                                        <div class="product-price">@prod.SalePrice.Value.ToString("N0") <small class="fs-6">ج.م</small></div>
                                        <div class="product-old-price">@prod.Price.ToString("N0") ج.م</div>
                                    }
                                    else
                                    {
                                        <div class="product-price">@prod.Price.ToString("N0") <small class="fs-6">ج.م</small></div>
                                    }
                                </div>
                                <button class="btn btn-accent btn-sm rounded-pill px-3" onclick="addToCart(@prod.Id, 1)">
                                    <i class="bi bi-cart-plus"></i> أضف
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Verified Stores Banner -->
<section class="py-5 bg-light border-top border-bottom">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1">متاجر مصرية موثقة</h3>
                <p class="text-muted small mb-0">تسوّق بأمان مباشر من أصحاب العلامات والمصانع المعتمدة</p>
            </div>
            <a asp-controller="Store" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                دليل المتاجر <i class="bi bi-arrow-left"></i>
            </a>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var store in Model.TopStores)
            {
                <div class="col">
                    <div class="card card-souqna text-center p-4 h-100">
                        <div class="position-relative d-inline-block mx-auto mb-3">
                            <img src="@(store.LogoUrl ?? "https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=150")" class="rounded-circle border shadow-sm" style="width: 80px; height: 80px; object-fit: cover;" alt="@store.StoreName">
                            @if (store.IsVerified)
                            {
                                <span class="position-absolute bottom-0 end-0 bg-success text-white rounded-circle p-1" title="متجر موثق">
                                    <i class="bi bi-patch-check-fill"></i>
                                </span>
                            }
                        </div>
                        <h5 class="fw-bold mb-1">@store.StoreName</h5>
                        <p class="text-muted small text-truncate mb-2"><i class="bi bi-geo-alt me-1"></i>@store.City</p>
                        <p class="small text-muted mb-3" style="min-height: 40px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @store.Description
                        </p>
                        <div class="mt-auto">
                            <a asp-controller="Store" asp-action="Details" asp-route-slug="@store.Slug" class="btn btn-outline-accent btn-sm rounded-pill w-100">
                                زيارة المتجر (@store.Products.Count منتج)
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Seller Call to Action -->
<section class="py-5" style="background: linear-gradient(135deg, #0284C7 0%, #0F172A 100%);">
    <div class="container text-center text-white py-4">
        <h2 class="fw-bold mb-3">هل أنت تاجر أو صاحب مشروع وتريد زيادة مبيعاتك؟</h2>
        <p class="lead mb-4 max-w-xl mx-auto" style="max-width: 650px;">
            انضم الآن إلى شبكة سوقنا مجاناً، وانشر منتجاتك وفيديوهات الريلز وابدأ بالوصول لملايين العملاء في جميع محافظات مصر بدون أي عمولات خفية.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg text-primary fw-bold rounded-pill px-4">
                ابدأ البيع الآن مجاناً
            </a>
            <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-light btn-lg rounded-pill px-4">
                استعرض باقات التجار
            </a>
        </div>
    </div>
</section>
