@model List<Souqna.Core.Entities.StoreOrder>
@{
    Layout = "_SellerLayout";
    ViewData["Title"] = "الطلبات الواردة";
    var currentStatus = ViewBag.CurrentStatus as Souqna.Core.Enums.OrderStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0"><i class="bi bi-receipt text-accent me-2"></i> الطلبات الواردة لمتجرك</h3>
</div>

<!-- Status Filter Pills -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-action="Index" class="btn btn-sm rounded-pill @(!currentStatus.HasValue ? "btn-primary" : "btn-outline-secondary")">الكل (@Model.Count)</a>
    <a asp-action="Index" asp-route-status="@Souqna.Core.Enums.OrderStatus.Pending" class="btn btn-sm rounded-pill @(currentStatus == Souqna.Core.Enums.OrderStatus.Pending ? "btn-warning" : "btn-outline-secondary")">بانتظار التأكيد</a>
    <a asp-action="Index" asp-route-status="@Souqna.Core.Enums.OrderStatus.Confirmed" class="btn btn-sm rounded-pill @(currentStatus == Souqna.Core.Enums.OrderStatus.Confirmed ? "btn-info" : "btn-outline-secondary")">مؤكد</a>
    <a asp-action="Index" asp-route-status="@Souqna.Core.Enums.OrderStatus.Processing" class="btn btn-sm rounded-pill @(currentStatus == Souqna.Core.Enums.OrderStatus.Processing ? "btn-primary" : "btn-outline-secondary")">قيد التجهيز</a>
    <a asp-action="Index" asp-route-status="@Souqna.Core.Enums.OrderStatus.Shipped" class="btn btn-sm rounded-pill @(currentStatus == Souqna.Core.Enums.OrderStatus.Shipped ? "btn-secondary" : "btn-outline-secondary")">تم الشحن</a>
    <a asp-action="Index" asp-route-status="@Souqna.Core.Enums.OrderStatus.Delivered" class="btn btn-sm rounded-pill @(currentStatus == Souqna.Core.Enums.OrderStatus.Delivered ? "btn-success" : "btn-outline-secondary")">تم التسليم</a>
</div>

<div class="card card-souqna p-4">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-receipt fs-1 text-muted"></i>
            <h5 class="fw-bold mt-2">لا توجد طلبات في هذه الحالة</h5>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr class="small text-muted">
                        <th>رقم الطلب</th>
                        <th>تاريخ الطلب</th>
                        <th>المنتجات المطلوبة</th>
                        <th>قيمة الشحنة</th>
                        <th>الحالة</th>
                        <th>رقم التتبع</th>
                        <th>إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var so in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@so.ParentOrder?.OrderNumber</td>
                            <td class="small text-muted">@so.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                <ul class="list-unstyled mb-0 small">
                                    @foreach (var it in so.Items)
                                    {
                                        <li>@it.ProductName (×@it.Quantity)</li>
                                    }
                                </ul>
                            </td>
                            <td>
                                <span class="fw-bold text-accent">@so.TotalAmount.ToString("N0")</span> <small class="text-muted">ج.م</small>
                            </td>
                            <td>
                                <span class="badge @(so.Status == Souqna.Core.Enums.OrderStatus.Delivered ? "bg-success" : so.Status == Souqna.Core.Enums.OrderStatus.Canceled ? "bg-danger" : "bg-warning text-dark")">
                                    @so.Status
                                </span>
                            </td>
                            <td class="small text-muted">@(so.TrackingNumber ?? "-")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@so.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    عرض وتحديث الحالة
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
