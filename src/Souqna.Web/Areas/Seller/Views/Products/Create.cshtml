@model Souqna.Web.ViewModels.ProductFormViewModel
@{
    Layout = "_SellerLayout";
    ViewData["Title"] = "إضافة منتج جديد";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">إضافة منتج جديد</h3>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">العودة للقائمة</a>
</div>

<div class="card card-souqna p-4 max-w-2xl">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label small fw-bold">اسم المنتج *</label>
                <input asp-for="Name" class="form-control" placeholder="مثال: قميص قطني فاخر مقاس L" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CategoryId" class="form-label small fw-bold">القسم *</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select" required></select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Price" class="form-label small fw-bold">السعر الأساسي (ج.م) *</label>
                <input asp-for="Price" class="form-control" type="number" step="0.5" required />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="SalePrice" class="form-label small fw-bold">سعر الخصم / التخفيض (اختياري)</label>
                <input asp-for="SalePrice" class="form-control" type="number" step="0.5" placeholder="اتركه فارغاً إن لم يكن هناك خصم" />
            </div>

            <div class="col-md-4">
                <label asp-for="StockQuantity" class="form-label small fw-bold">الكمية المتوفرة بالمخزن *</label>
                <input asp-for="StockQuantity" class="form-control" type="number" min="0" required />
                <span asp-validation-for="StockQuantity" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="SKU" class="form-label small fw-bold">رمز المنتج (SKU)</label>
                <input asp-for="SKU" class="form-control" placeholder="PROD-001" />
            </div>

            <div class="col-md-6">
                <label asp-for="MainImage" class="form-label small fw-bold">صورة المنتج الرئيسية</label>
                <input asp-for="MainImage" class="form-control" type="file" accept="image/*" />
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label small fw-bold">وصف وتفاصيل المنتج *</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="اكتب وصفاً مفصلاً يوضح خامة المنتج، مميزاته، مقاساته وكيفية استخدامه..." required></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" asp-for="IsPublished" id="pubCheck" checked>
                    <label class="form-check-label small fw-bold" for="pubCheck">نشر المنتج فوراً في السوق</label>
                </div>
            </div>

            <div class="col-12 mt-4">
                <button type="submit" class="btn btn-accent btn-lg px-5 rounded-pill shadow">
                    حفظ ونشر المنتج <i class="bi bi-check-lg ms-1"></i>
                </button>
            </div>
        </div>
    </form>
</div>
