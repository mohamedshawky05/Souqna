@model Souqna.Core.Entities.Store
@{
    Layout = "_SellerLayout";
    ViewData["Title"] = "إعدادات المتجر";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0"><i class="bi bi-sliders text-accent me-2"></i> إعدادات وتخصيص المتجر</h3>
    <a asp-area="" asp-controller="Store" asp-action="Details" asp-route-slug="@Model.Slug" target="_blank" class="btn btn-outline-accent rounded-pill btn-sm">
        <i class="bi bi-eye me-1"></i> معاينة المتجر بالسوق
    </a>
</div>

<div class="card card-souqna p-4 max-w-2xl">
    <form asp-action="Index" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small fw-bold">اسم المتجر *</label>
                <input type="text" name="storeName" value="@Model.StoreName" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label class="form-label small fw-bold">المحافظة / المدينة *</label>
                <select name="city" class="form-select" required>
                    <option value="القاهرة" selected="@(Model.City == "القاهرة")">القاهرة</option>
                    <option value="الجيزة" selected="@(Model.City == "الجيزة")">الجيزة</option>
                    <option value="الإسكندرية" selected="@(Model.City == "الإسكندرية")">الإسكندرية</option>
                    <option value="الشرقية" selected="@(Model.City == "الشرقية")">الشرقية</option>
                    <option value="الدقهلية" selected="@(Model.City == "الدقهلية")">الدقهلية</option>
                    <option value="أسوان" selected="@(Model.City == "أسوان")">أسوان</option>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label small fw-bold">العنوان التفصيلي ومقر المتجر</label>
                <input type="text" name="address" value="@Model.Address" class="form-control" placeholder="الشارع، المنطقة، رقم العقار..." />
            </div>

            <div class="col-md-6">
                <label class="form-label small fw-bold">هاتف التواصل وخدمة العملاء</label>
                <input type="text" name="contactPhone" value="@Model.ContactPhone" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label small fw-bold">البريد الإلكتروني التجاري</label>
                <input type="email" name="contactEmail" value="@Model.ContactEmail" class="form-control" />
            </div>

            <div class="col-12">
                <label class="form-label small fw-bold">نبذة ووصف المتجر</label>
                <textarea name="description" class="form-control" rows="3">@Model.Description</textarea>
            </div>

            <div class="col-md-6">
                <label class="form-label small fw-bold">شعار المتجر (Logo)</label>
                <input type="file" name="logoFile" class="form-control" accept="image/*" />
                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                {
                    <img src="@Model.LogoUrl" class="rounded-circle border mt-2" style="width: 50px; height: 50px; object-fit: cover;" alt="شعار المتجر">
                }
            </div>

            <div class="col-md-6">
                <label class="form-label small fw-bold">غلاف المتجر الرئيسي (Cover)</label>
                <input type="file" name="coverFile" class="form-control" accept="image/*" />
                @if (!string.IsNullOrEmpty(Model.CoverUrl))
                {
                    <img src="@Model.CoverUrl" class="rounded border mt-2" style="width: 100px; height: 50px; object-fit: cover;" alt="غلاف المتجر">
                }
            </div>

            <div class="col-12 mt-4">
                <button type="submit" class="btn btn-accent btn-lg px-5 rounded-pill shadow">
                    حفظ التغييرات <i class="bi bi-check-lg ms-1"></i>
                </button>
            </div>
        </div>
    </form>
</div>
