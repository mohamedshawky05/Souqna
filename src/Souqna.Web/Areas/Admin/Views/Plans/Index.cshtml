@model List<Souqna.Core.Entities.SubscriptionPlan>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "إدارة باقات الاشتراك والحدود";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-credit-card-2-front text-primary me-2"></i> باقات الاشتراكات والحدود البرمجية</h3>
        <p class="text-muted small mb-0">تعديل الأسعار والحدود القصوى للمنتجات، الفيديوهات ومدة الريلز المسموحة في قاعدة البيانات مباشرة.</p>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
    @foreach (var plan in Model)
    {
        <div class="col">
            <div class="card card-souqna h-100 p-4 text-center">
                <span class="badge @(plan.IsActive ? "bg-success" : "bg-secondary") mb-2">@(plan.IsActive ? "نشطة" : "معطلة")</span>
                <h5 class="fw-bold mb-1">@plan.NameAr</h5>
                <p class="text-muted small mb-2">@plan.NameEn</p>

                <div class="my-3 py-2 bg-light rounded-3 border">
                    <span class="fs-4 fw-bold text-accent">@plan.PriceMonthly.ToString("N0")</span>
                    <small class="text-muted">ج.م شهرياً</small>
                </div>

                <ul class="list-unstyled text-start small mb-4 d-flex flex-column gap-2 flex-grow-1">
                    <li><i class="bi bi-box-seam text-primary me-1"></i> المنتجات: <strong>@plan.MaxActiveProducts</strong></li>
                    <li><i class="bi bi-camera-reels text-danger me-1"></i> الريلز: <strong>@plan.MaxPublishedVideos</strong></li>
                    <li><i class="bi bi-clock-history text-warning me-1"></i> أقصى مدة: <strong>@plan.MaxVideoDurationSeconds ثانية</strong></li>
                    <li><i class="bi bi-hdd-network text-info me-1"></i> سعة التخزين: <strong>@plan.StorageLimitMb ميجابايت</strong></li>
                </ul>

                <a asp-action="Edit" asp-route-id="@plan.Id" class="btn btn-outline-primary rounded-pill w-100">
                    <i class="bi bi-pencil me-1"></i> تعديل الأسعار والحدود
                </a>
            </div>
        </div>
    }
</div>
