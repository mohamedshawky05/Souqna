@model Souqna.Core.Entities.SubscriptionPlan
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"تعديل باقة {Model.NameAr}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">تعديل باقة: @Model.NameAr (@Model.NameEn)</h3>
        <p class="text-muted small mb-0">التغييرات ستسري فوراً على قاعدة البيانات وقواعد التحقق على السيرفر.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">العودة للباقات</a>
</div>

<div class="card card-souqna p-4 max-w-2xl">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="NameAr" class="form-label small fw-bold">اسم الباقة (بالعربية) *</label>
                <input asp-for="NameAr" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="NameEn" class="form-label small fw-bold">اسم الباقة (بالإنجليزية) *</label>
                <input asp-for="NameEn" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="PriceMonthly" class="form-label small fw-bold">السعر الشهري (ج.م) *</label>
                <input asp-for="PriceMonthly" class="form-control" type="number" step="0.5" required />
            </div>

            <div class="col-md-6">
                <label asp-for="PriceYearly" class="form-label small fw-bold">السعر السنوي (ج.م) *</label>
                <input asp-for="PriceYearly" class="form-control" type="number" step="0.5" required />
            </div>

            <div class="col-md-4">
                <label asp-for="MaxActiveProducts" class="form-label small fw-bold">الحد الأقصى للمنتجات النشطة *</label>
                <input asp-for="MaxActiveProducts" class="form-control" type="number" required />
            </div>

            <div class="col-md-4">
                <label asp-for="MaxPublishedVideos" class="form-label small fw-bold">الحد الأقصى لفيديوهات الريلز *</label>
                <input asp-for="MaxPublishedVideos" class="form-control" type="number" required />
            </div>

            <div class="col-md-4">
                <label asp-for="MaxVideoDurationSeconds" class="form-label small fw-bold">أقصى مدة للفيديو (بالثواني) *</label>
                <input asp-for="MaxVideoDurationSeconds" class="form-control" type="number" required />
            </div>

            <div class="col-md-6">
                <label asp-for="StorageLimitMb" class="form-label small fw-bold">المساحة التخزينية (ميجابايت)</label>
                <input asp-for="StorageLimitMb" class="form-control" type="number" required />
            </div>

            <div class="col-md-6">
                <label asp-for="DescriptionAr" class="form-label small fw-bold">وصف الباقة التسويقي</label>
                <input asp-for="DescriptionAr" class="form-control" />
            </div>

            <div class="col-12">
                <div class="d-flex flex-wrap gap-4 p-3 bg-light rounded-3 border">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="AllowsCoupons" id="couponsCheck">
                        <label class="form-check-label small" for="couponsCheck">السماح بإنشاء كوبونات وتخفيضات</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="AllowsCsvExportImport" id="csvCheck">
                        <label class="form-check-label small" for="csvCheck">استيراد وتصدير CSV</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="HasAdvancedAnalytics" id="analyticsCheck">
                        <label class="form-check-label small" for="analyticsCheck">تحليلات متقدمة وسلوك المشترين</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" id="activeCheck">
                        <label class="form-check-label small" for="activeCheck">الباقة نشطة ومتاحة للاشتراك</label>
                    </div>
                </div>
            </div>

            <div class="col-12 mt-4">
                <button type="submit" class="btn btn-accent btn-lg px-5 rounded-pill shadow">
                    حفظ التعديلات في النظام <i class="bi bi-check-lg ms-1"></i>
                </button>
            </div>
        </div>
    </form>
</div>
