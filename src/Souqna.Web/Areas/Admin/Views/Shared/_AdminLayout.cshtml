@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - لوحة تحكم الإدارة العامة | سوقنا</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .sidebar-admin {
            min-height: calc(100vh - 65px);
            background-color: var(--card-bg);
            border-left: 1px solid var(--border-color);
        }
        .nav-link-admin {
            color: var(--text-muted);
            font-weight: 600;
            padding: 0.75rem 1rem;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transition: var(--transition);
        }
        .nav-link-admin:hover, .nav-link-admin.active {
            background-color: rgba(14, 165, 233, 0.1);
            color: var(--accent-color);
        }
    </style>
</head>
<body>
    @Html.AntiForgeryToken()

    <!-- Top Admin Bar -->
    <nav class="navbar navbar-dark bg-dark px-3 py-2 border-bottom sticky-top" style="background-color: #020617 !important;">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="navbar-brand-badge"><i class="bi bi-shield-shaded"></i> سوقنا</span>
                <span class="badge bg-danger small">إدارة المنصة</span>
            </a>

            <div class="d-flex align-items-center gap-3">
                @await Html.PartialAsync("_NotificationBell")

                <button class="btn btn-sm btn-outline-light rounded-circle" type="button" onclick="toggleTheme()" title="تبديل المظهر">
                    <i id="theme-toggle-icon" class="bi bi-moon-stars-fill"></i>
                </button>

                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-light rounded-pill px-3">
                    <i class="bi bi-arrow-right"></i> واجهة الموقع
                </a>

                <div class="dropdown">
                    <button class="btn btn-sm btn-danger rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-badge me-1"></i> @user?.FullName
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile"><i class="bi bi-gear me-2"></i> حسابي</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i> خروج</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-2 col-md-3 p-3 sidebar-admin">
                <ul class="nav flex-column gap-1">
                    <li class="nav-item">
                        <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> لوحة الإدارة العامة
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "Verification" ? "active" : "")" asp-area="Admin" asp-controller="Verification" asp-action="Index">
                            <i class="bi bi-person-check"></i> طابور توثيق الهوية
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "Stores" ? "active" : "")" asp-area="Admin" asp-controller="Stores" asp-action="Index">
                            <i class="bi bi-shop"></i> المتاجر والبائعين
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "Plans" ? "active" : "")" asp-area="Admin" asp-controller="Plans" asp-action="Index">
                            <i class="bi bi-credit-card-2-front"></i> باقات الاشتراكات والحدود
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "SubscriptionPayments" ? "active" : "")" asp-area="Admin" asp-controller="SubscriptionPayments" asp-action="Index">
                            <i class="bi bi-cash-coin"></i> طلبات الاشتراك والدفع
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")" asp-area="Admin" asp-controller="Products" asp-action="Index">
                            <i class="bi bi-box-seam"></i> مراقبة المنتجات
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reels" ? "active" : "")" asp-area="Admin" asp-controller="Reels" asp-action="Index">
                            <i class="bi bi-camera-reels"></i> مراقبة الريلز
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                            <i class="bi bi-receipt"></i> جميع طلبات المنصة
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLogs" ? "active" : "")" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">
                            <i class="bi bi-journal-text"></i> سجل العمليات والأمان
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Content Area -->
            <div class="col-lg-10 col-md-9 p-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.13/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
